{
  "name": "codex-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sidecar web controller and network viewer for Codex CLI",
  "bin": {
    "codex-viewer": "cli.js"
  },
  "scripts": {
    "start": "node scripts/workspace-cli.js start --foreground",
    "start:bg": "node scripts/workspace-cli.js start",
    "dev": "npm run start",
    "open": "node scripts/workspace-cli.js open",
    "status": "node scripts/workspace-cli.js status",
    "stop": "node scripts/workspace-cli.js stop",
    "smoke": "node scripts/smoke.js",
    "smoke:approval": "node scripts/smoke.js --mode approval",
    "here": "npm run start",
    "here:bg": "npm run start:bg",
    "open:here": "npm run open",
    "status:here": "npm run status",
    "stop:here": "npm run stop",
    "here:public": "npm run start",
    "here:public:bg": "npm run start:bg"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.11.1"
  }
}
